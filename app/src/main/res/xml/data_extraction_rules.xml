<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior: la foto de perfil no se incluye en copias en la nube ni en transferencias. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="profile_photo.png" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="profile_photo.png" />
    </device-transfer>
</data-extraction-rules>
